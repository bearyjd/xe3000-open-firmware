# Build container for the OpenWrt 25.12.x recipe. Base is debian 12-slim pinned by digest.
# The source tree is mounted at run time (see container-build.sh); nothing router-related is in the image.
FROM docker.io/library/debian@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    build-essential clang flex bison g++ gawk gettext git libncurses-dev libssl-dev \
    python3 python3-setuptools rsync swig unzip zlib1g-dev file wget curl ca-certificates \
    xsltproc zstd patch diffutils \
 && rm -rf /var/lib/apt/lists/*

# OpenWrt refuses to build as root.
RUN useradd --create-home --uid 1000 build
USER build
WORKDIR /home/build/work
