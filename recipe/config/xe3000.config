# Seed .config for the GL-XE3000 (Puli AX). Expanded by `make defconfig` inside the build container.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-xe3000=y
# PCIe modem (MHI) support; the PCI ID patch lives in patches/kernel.
CONFIG_PACKAGE_kmod-mhi-bus=y
CONFIG_PACKAGE_kmod-mhi-pci-generic=y
# Battery/fan MCU helper, built from the local feed (recipe/feeds/xe3000), XE3000 only.
CONFIG_PACKAGE_gl-puli-mcu=y
