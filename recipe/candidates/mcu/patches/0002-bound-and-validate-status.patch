+static bool
+integer(const char **cursor, int min, int max, int *value)
+{
+	const char *from = *cursor;
+	char *end;
+	long parsed;
+
+	/* No whitespace, plus sign, decimal fractions, or silent narrowing. */
+	if (*from == '-' && min < 0)
+		from++;
+	if (*from < '0' || *from > '9')
+		return false;
+	errno = 0;
+	parsed = strtol(*cursor, &end, 10);
+	if (errno == ERANGE || parsed < min || parsed > max)
+		return false;
+	*value = parsed;
+	*cursor = end;
+	return true;
+}
