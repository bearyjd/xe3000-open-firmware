+static uint64_t
+monotonic_ms(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+static bool
+literal(const char **cursor, const char *text)
+{
+	size_t len = strlen(text);
+	if (strncmp(*cursor, text, len))
+		return false;
+	*cursor += len;
+	return true;
+}
